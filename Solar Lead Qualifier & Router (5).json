{
  "name": "Solar Lead Qualifier & Router",
  "nodes": [
    {
      "parameters": {
        "promptType": "define",
        "text": "=Score this solar lead from 1-10 and return ONLY raw JSON, no markdown, with keys: score, recommended_action (one of human_sales/automated_nurture/deep_research), reasoning. Lead data: {{ JSON.stringify($json.body) }}"
      },
      "id": "2b1d5116-3b0d-4c96-bb5a-7223b4c88171",
      "name": "Score Lead with Gemini",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        -3200,
        304
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.5-flash-lite",
        "options": {
          "maxOutputTokens": 1024,
          "temperature": 0.3
        }
      },
      "id": "d642b24d-7993-4238-8a9d-ab1a3485fc85",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        -3184,
        512
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "zTXW4fz2mIj2EB4i",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Extract response text safely (handles .text from Gemini or .response from Claude)\nconst rawItem = $input.first().json;\nconst aiResponse = rawItem.text || rawItem.response || rawItem.output;\n\nif (!aiResponse) {\n  throw new Error(\"No text output found from the AI node.\");\n}\n\n// Strip markdown code fences if present\nlet cleaned = aiResponse.trim();\ncleaned = cleaned.replace(/^```(?:json)?\\s*\\n?/i, '');\ncleaned = cleaned.replace(/\\n?```\\s*$/i, '');\n\n// Find JSON object in the cleaned response\nconst jsonMatch = cleaned.match(/\\{[\\s\\S]*\\}/);\nif (!jsonMatch) {\n  throw new Error('No valid JSON found in AI response: ' + aiResponse);\n}\n\nconst parsed = JSON.parse(jsonMatch[0]);\n\n// Validate required fields\nif (parsed.score === undefined || !parsed.recommended_action || !parsed.reasoning) {\n  throw new Error('Missing required fields. Got: ' + JSON.stringify(parsed));\n}\n\nconst validActions = ['human_sales', 'automated_nurture', 'deep_research'];\nif (!validActions.includes(parsed.recommended_action)) {\n  throw new Error('Invalid recommended_action: ' + parsed.recommended_action);\n}\n\n// Clamp score to 1-10 range\nconst score = Math.max(1, Math.min(10, Math.round(parsed.score)));\n\n// Return structured data with original lead info\nreturn [{\n  json: {\n    score: score,\n    recommended_action: parsed.recommended_action,\n    reasoning: parsed.reasoning,\n    confidence: score / 10,\n    lead: $('Webhook Trigger1').first().json.body\n  }\n}];"
      },
