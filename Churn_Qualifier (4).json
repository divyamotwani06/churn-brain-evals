    {
      "parameters": {
        "promptType": "define",
        "text": "=Score this customer's churn risk from 1-10 (10 = very likely to cancel soon) and return ONLY raw JSON, no markdown, with keys: score, recommended_action (one of retention_call/automated_winback/monitor), reasoning. Use retention_call for high risk (7-10), automated_winback for medium risk (4-6), monitor for low risk (1-3). Customer data: {{ JSON.stringify($json.body) }}"
      },
      "id": "dadf1f0e-779e-489a-b662-84ca718ef690",
      "name": "Score Churn Risk with Gemini1",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        -3632,
        9488
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Extract response text safely (handles .text from Gemini or .response from Claude)\nconst rawItem = $input.first().json;\nconst aiResponse = rawItem.text || rawItem.response || rawItem.output;\n\nif (!aiResponse) {\n  throw new Error(\"No text output found from the AI node.\");\n}\n\n// Strip markdown code fences if present\nlet cleaned = aiResponse.trim();\ncleaned = cleaned.replace(/^```(?:json)?\\s*\\n?/i, '');\ncleaned = cleaned.replace(/\\n?```\\s*$/i, '');\n\n// Find JSON object in the cleaned response\nconst jsonMatch = cleaned.match(/\\{[\\s\\S]*\\}/);\nif (!jsonMatch) {\n  throw new Error('No valid JSON found in AI response: ' + aiResponse);\n}\n\nconst parsed = JSON.parse(jsonMatch[0]);\n\n// Validate required fields\nif (parsed.score === undefined || !parsed.recommended_action || !parsed.reasoning) {\n  throw new Error('Missing required fields. Got: ' + JSON.stringify(parsed));\n}\n\nconst validActions = ['retention_call', 'automated_winback', 'monitor'];\nif (!validActions.includes(parsed.recommended_action)) {\n  throw new Error('Invalid recommended_action: ' + parsed.recommended_action);\n}\n\n// Clamp score to 1-10 range\nconst score = Math.max(1, Math.min(10, Math.round(parsed.score)));\n\n// Return structured data with original lead info\nreturn [{\n  json: {\n    score: score,\n    recommended_action: parsed.recommended_action,\n    reasoning: parsed.reasoning,\n    confidence: score / 10,\n    customer: $('Churn Webhook1').first().json.body\n  }\n}];"
      },
